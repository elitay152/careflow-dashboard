{
  "name": "careflow-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/validate-data.mjs && node scripts/validate-flu.mjs && node scripts/validate-readmission.mjs && node scripts/check-artifacts.mjs --public && tsc --noEmit && vite build && node scripts/check-artifacts.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:capacity && npm run test:components && playwright test",
    "data:sync": "node scripts/sync-data.mjs",
    "data:refresh": "node scripts/refresh-data.mjs",
    "data:check": "node scripts/validate-data.mjs",
    "test:security": "node --test tests/security.test.mjs tests/flu-security.test.mjs tests/readmission-security.test.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:capacity": "node --experimental-strip-types --test tests/capacity.test.mjs",
    "flu:sync": "node scripts/sync-flu.mjs",
    "flu:refresh": "node scripts/refresh-flu.mjs",
    "flu:check": "node scripts/validate-flu.mjs",
    "readmission:sync": "node scripts/sync-readmission.mjs",
    "readmission:check": "node scripts/validate-readmission.mjs",
    "test:components": "node --test tests/readmission-finding.test.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
